{
    "extends": "../tinycld/packages/@tinycld/core/tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "..",
        "paths": {
            "~/tinycld/contacts/*": ["./tinycld/contacts/*"],
            "@tinycld/core/*": ["../tinycld/packages/@tinycld/core/*"],
            "@tinycld/*": ["../tinycld/packages/@tinycld/*"],
            "~/*": ["../tinycld/packages/@tinycld/core/*"]
        },
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx", "../tinycld/packages/@tinycld/core/**/*.d.ts", "../tinycld/packages/@tinycld/core/expo-env.d.ts", "../tinycld/packages/@tinycld/core/.expo/types/**/*.ts"],
    "exclude": ["node_modules", "server", "pb-migrations", "tests/**/*.spec.ts"]
}
